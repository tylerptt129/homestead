{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@homestead/ui/*": ["../../packages/ui/*"],
      "@homestead/core/*": ["../../packages/core/*"],
      "@homestead/data/*": ["../../packages/data/*"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
